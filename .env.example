# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/app

# JWT signing key; use a long random value in each environment
SESSION_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Links included in verification and password reset emails
FRONTEND_URL=http://localhost:5000
VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Optional SMTP delivery. If SMTP_HOST is blank, links are logged for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true